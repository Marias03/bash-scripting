#!/usr/bin/env bash

usage() {
    echo "Использование: $0 каталог старый_суффикс новый_суффикс" >&2
    echo "Пример: $0 ./docs .txt .md" >&2
    exit 1
}

(( $# == 3 )) || usage

dir=$1
old=$2
new=$3

# Проверка аргументов
if [[ ! -d "$dir" ]]; then
    echo "Ошибка: '$dir' не является каталогом" >&2
    exit 1
fi

for s in "$old" "$new"; do
    if [[ ! "$s" =~ ^\.[^./]+$ ]]; then
        echo "Ошибка: '$s' не является суффиксом (начинается с точки и больше не содержит точек)" >&2
        exit 1
    fi
done

# Суффикс имени файла. Точка в начале имени - не начало суффикса.
get_suffix() {
    local name=$1
    local rest=${name:1}
    [[ "$rest" == *.* ]] || return 1
    echo ".${rest##*.}"
}

# Рекурсивно собираем все регулярные файлы
mapfile -d '' files < <(find "$dir" -type f -print0)

count=0
for path in "${files[@]}"; do
    name=${path##*/}
    suffix=$(get_suffix "$name") || continue
    [[ "$suffix" == "$old" ]] || continue

    # Раскрытие параметра с заменой: меняем суффикс в конце пути
    new_path=${path/%"$old"/"$new"}

    if [[ -e "$new_path" ]]; then
        echo "Пропущен (файл уже существует): $new_path" >&2
        continue
    fi

    mv -- "$path" "$new_path" && echo "$path -> $new_path" && count=$(( count + 1 ))
done

echo "Переименовано файлов: $count"
exit 0
