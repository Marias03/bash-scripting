#!/usr/bin/env bash

trap 'echo; echo "Чтобы завершить работу, введите q или Q"' SIGINT

declare -i disks=${DISKS:-8}
declare -a A=()
declare -a B=()
declare -a C=()
declare -i move_no=1

# Стек A: 8 7 6 5 4 3 2 1 (последний элемент массива - вершина стека)
for (( i = disks; i >= 1; i-- )); do A+=("$i"); done

# Одна ячейка стека $1 на уровне $2 (0 - дно)
cell() {
    local -n st=$1
    if (( $2 < ${#st[@]} )); then
        printf "|%s|" "${st[$2]}"
    else
        printf "| |"
    fi
}

print_stacks() {
    local lvl
    for (( lvl = 7; lvl >= 0; lvl-- )); do
        echo "$(cell A "$lvl") $(cell B "$lvl") $(cell C "$lvl")"
    done
    echo "+-+ +-+ +-+"
    echo " A   B   C"
}

# 0 - перемещено, 1 - стек пуст, 2 - перемещение запрещено
try_move() {
    local -n src=$1 dst=$2
    (( ${#src[@]} == 0 )) && return 1
    local top=${src[-1]}
    if (( ${#dst[@]} > 0 )) && (( ${dst[-1]} < top )); then
        return 2
    fi
    dst+=("$top")
    unset "src[$(( ${#src[@]} - 1 ))]"
    return 0
}

while :
do
    print_stacks

    while :
    do
        read -r -p "Ход № ${move_no} (откуда, куда): " input
        rc=$?
        if (( rc > 128 )); then
            continue
        elif (( rc != 0 )); then
            exit 1
        fi
        [[ -z "$input" ]] && continue

        s=${input// /}
        s=${s^^}

        if [[ "$s" == "Q" ]]; then
            echo "Выход."
            exit 1
        fi

        if [[ ! "$s" =~ ^[ABC][ABC]$ ]] || [[ "${s:0:1}" == "${s:1:1}" ]]; then
            echo "Ошибка! Введите имена двух разных стеков (A, B, C), например: ab или A C. q/Q - выход."
            continue
        fi

        try_move "${s:0:1}" "${s:1:1}"
        case $? in
            1) echo "Стек ${s:0:1} пуст!"; continue ;;
            2) echo "Такое перемещение запрещено!"; continue ;;
        esac
        break
    done

    move_no+=1

    if (( ${#B[@]} == disks || ${#C[@]} == disks )); then
        print_stacks
        echo "Победа! Башня собрана за $(( move_no - 1 )) ходов."
        exit 0
    fi
done
