#!/usr/bin/env bash

trap 'echo; echo "Чтобы завершить работу, введите q или Q"' SIGINT

has_repeats() {
    local s=$1 i
    for (( i = 0; i < ${#s}; i++ )); do
        [[ "${s:i+1}" == *"${s:i:1}"* ]] && return 0
    done
    return 1
}

secret=""
while (( ${#secret} < 4 )); do
    d=${RANDOM: -1}
    [[ -z "$secret" && "$d" == "0" ]] && continue
    [[ "$secret" == *"$d"* ]] || secret+="$d"
done

cat << 'EOF'
********************************************************************************
* Я загадал 4-значное число с неповторяющимися цифрами. На каждом ходу делайте *
* попытку отгадать загаданное число. Попытка - это 4-значное число с           *
* неповторяющимися цифрами.                                                    *
********************************************************************************
EOF

declare -i attempt=1
declare -a history=()

while :
do
    read -r -p "Попытка ${attempt}: " guess
    rc=$?
    if (( rc > 128 )); then
        continue
    elif (( rc != 0 )); then
        exit 1
    fi

    case "$guess" in
        "") continue ;;
        q|Q) echo "Выход."; exit 1 ;;
    esac

    if [[ ! "$guess" =~ ^[1-9][0-9]{3}$ ]] || has_repeats "$guess"; then
        echo "Ошибка! Введите 4-значное число с неповторяющимися цифрами (q/Q - выход)."
        continue
    fi

    declare -i bulls=0 cows=0
    for i in 0 1 2 3; do
        g=${guess:i:1}
        if [[ "$g" == "${secret:i:1}" ]]; then
            bulls+=1
        elif [[ "$secret" == *"$g"* ]]; then
            cows+=1
        fi
    done

    echo "Коров - ${cows} Быков - ${bulls}"
    history+=("${attempt}. ${guess} (Коров - ${cows} Быков - ${bulls})")

    echo "История ходов:"
    printf '%s\n' "${history[@]}"
    echo

    if (( bulls == 4 )); then
        echo "Поздравляю! Вы угадали число ${secret}!"
        exit 0
    fi

    attempt+=1
done
